#Goodness of fit test
AD.stat <- function(x, shape, scale){
  
  x <- sort(x)
  n <- length(x)
  
  F <- pgpd(x,
            loc = 0,
            scale = scale,
            shape = shape)
  
  eps <- 1e-10
  F[F < eps] <- eps
  F[F > 1 - eps] <- 1 - eps
  
  i <- 1:n
  
  A2 <- -n -
    (1/n) * sum((2*i-1) *
                  (log(F) + log(1-rev(F))))
  
  return(A2)
}
shape <- GPDNegative$param["shape"]
scale <- GPDNegative$param["scale"]

obs.AD <- AD.stat(exceedances, shape, scale)
obs.AD
set.seed(123)

B <- 10000
boot.AD <- numeric(B)

n <- length(exceedances)

for(i in 1:B){
  
  sim <- rgpd(n,
              loc = 0,
              scale = scale,
              shape = shape)
  
  fit <- fitgpd(sim,
                threshold = 0,
                est = "mle")
  
  shape.b <- fit$param["shape"]
  scale.b <- fit$param["scale"]
  
  boot.AD[i] <- AD.stat(sim,
                        shape.b,
                        scale.b)
}
p.boot <- mean(boot.AD >= obs.AD)
p.boot


