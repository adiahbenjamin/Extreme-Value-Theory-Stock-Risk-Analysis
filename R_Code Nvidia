#Goodness of fit test
# Anderson-Darling statistic
AD.stat <- function(x, shape, scale){
  
  x <- sort(x)
  n <- length(x)
  
  # Fitted GPD CDF
  F <- pgpd(x,
            loc = 0,
            scale = scale,
            shape = shape)
  
# Avoid log(0)
eps <- 1e-10
F[F < eps] <- eps
F[F > 1 - eps] <- 1 - eps
  
i <- 1:n
  
A2 <- -n -
  (1/n) * sum((2*i-1) *
                (log(F) + log(1-rev(F))))
  
  return(A2)
}
